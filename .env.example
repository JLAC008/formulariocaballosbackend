# ==========================================
# Configuración Base de Datos (PostgreSQL)
# ==========================================
# Estas variables configuran tanto la creación de la base de datos
# en el contenedor de PostgreSQL como la conexión desde Spring Boot.
DB_NAME=formulariocaballos
DB_USER=formulariocaballos
DB_PASSWORD=formulariocaballos_secret
# Host y puerto de la base de datos. En local apunta al contenedor de Docker (localhost:5433).
# En Dokploy apunta a tu PostgreSQL interno de Dokploy (ej: DB_HOST=postgres-caballos, DB_PORT=5432)
DB_HOST=localhost
DB_PORT=5433

# ==========================================
# Configuración Seguridad y JWT
# ==========================================
# El secreto debe tener al menos 32 caracteres (256 bits)
JWT_SECRET=base64-encoded-256-bit-secret-for-jwt-signing-at-least-32-chars
# Cuenta de administrador por defecto
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
# Si está en true, los usuarios deben confirmar el correo antes de iniciar sesión.
# Si está en false, las cuentas registradas desde el frontend nacen verificadas.
EMAIL_VERIFICATION_REQUIRED=true

# ==========================================
# Configuración Email (Brevo Transactional Email API)
# ==========================================
# Envío vía la API HTTP de Brevo (POST /v3/smtp/email) con la API key.
MAIL_FROM=martinezluna@pistasvalleperdido.es
# API key de Brevo (Panel > SMTP & API > API Keys). Empieza por xkeysib-.
# La IP desde la que se envía debe estar autorizada en Brevo (Panel > Seguridad > IPs autorizadas).
# En local, este valor se pone en .env.local: si existe .env.local, la app usa
# SOLO .env.local (ignora .env).
BREVO_API_KEY=

# ==========================================
# Configuración Frontend / CORS
# ==========================================
# URL de tu frontend (ej: https://tudominio.com). 
# Se usa para los enlaces de los correos (recuperar contraseña) y por defecto para el CORS.
FRONTEND_URL=http://localhost:4200
# Descomentar solo si necesitas que el CORS admita múltiples orígenes distintos al frontend principal

# CORS_ORIGINS=http://localhost:4200,https://otrodominio.com

# ==========================================
# Configuracion Subida de Ficheros
# ==========================================
# Carpeta donde se guardan las imagenes subidas desde el panel administrador.
UPLOAD_DIR=C:/workspace/FormularioCaballosBackend/uploads

# ==========================================
# Configuracion Stripe
# ==========================================
# Clave secreta de Stripe. En local puedes usar una sk_test_...
STRIPE_SECRET_KEY=
# Secreto del endpoint webhook de Stripe. En local lo da Stripe CLI con listen.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
