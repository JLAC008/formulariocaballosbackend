# ==========================================
# Configuración Base de Datos (PostgreSQL)
# ==========================================
POSTGRES_DB=formulariocaballos
POSTGRES_USER=formulariocaballos
POSTGRES_PASSWORD=formulariocaballos_secret

# ==========================================
# Configuración Spring Boot
# ==========================================
# URL para conectar desde el contenedor de Spring Boot a la base de datos
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/formulariocaballos
SPRING_DATASOURCE_USERNAME=formulariocaballos
SPRING_DATASOURCE_PASSWORD=formulariocaballos_secret

# ==========================================
# Configuración Seguridad y JWT
# ==========================================
# El secreto debe tener al menos 32 caracteres (256 bits)
JWT_SECRET=base64-encoded-256-bit-secret-for-jwt-signing-at-least-32-chars
# Cuenta de administrador por defecto
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# ==========================================
# Configuración Servidor de Email (SMTP)
# ==========================================
# Ej: smtp.gmail.com
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@formulariocaballos.local

# ==========================================
# Configuración Frontend / CORS
# ==========================================
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
